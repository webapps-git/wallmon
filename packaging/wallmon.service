# wallmon on the server-room monitor: kmscon on tty1 runs wallmon instead of a login prompt.
# Ctrl+Alt+F2 switches to a normal login on tty2.

[Unit]
Description=wallmon status board on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=rc-local.service systemd-vconsole-setup.service
Before=getty.target
Conflicts=getty@tty1.service rescue.service
Before=rescue.service
IgnoreOnIsolate=yes
ConditionPathExists=/dev/tty0

[Service]
# --dpms-timeout=0: kmscon would otherwise blank the screen after 10 minutes without input.
# --no-reset-env: wallmon needs PATH from systemd to find mariadb, setpriv and the like.
# --oneshot: kmscon exits together with wallmon, and systemd starts both again.
ExecStart=/usr/bin/kmscon --vt=tty1 --no-switchvt --oneshot --no-reset-env --dpms-timeout=0 \
    --no-mouse --no-blink --session-max=1 "--font-name=DejaVu Sans Mono" --font-size=16 \
    --login -- /usr/local/bin/wallmon
Restart=always
RestartSec=5
Nice=5
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target

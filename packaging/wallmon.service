# wallmon on the server-room monitor: wallmon runs on tty1 instead of a login prompt.
# Ctrl+Alt+F2 switches to a normal login on tty2. To run it in kmscon instead of the
# plain console, see "Console" in the README.

[Unit]
Description=wallmon status board on tty1
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=rc-local.service systemd-vconsole-setup.service
Before=getty.target
Conflicts=getty@tty1.service rescue.service
Before=rescue.service
IgnoreOnIsolate=yes
ConditionPathExists=/dev/tty0

[Service]
# The plain console: wallmon sees TERM=linux and draws with 16 colours and no braille.
Environment=TERM=linux
# Keep the console from blanking the screen; the keyboard is never touched.
ExecStartPre=-/usr/bin/setterm --blank 0 --powerdown 0
ExecStart=/usr/local/sbin/wallmon
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
